# react-scripts 5 pulls ajv-keywords@5, which needs ajv@8 via a *peer* dependency.
# With legacy-peer-deps=true (set in some global ~/.npmrc), npm skips that peer and
# ajv-keywords falls back to the hoisted ajv@6 from ESLint, crashing the dev server
# with "Cannot find module 'ajv/dist/compile/codegen'". Force correct peer resolution.
legacy-peer-deps=false
