# Copy to .env and fill in. Never commit .env.

# ---- DynamoDB ----
USERS_TABLE=rideshare-users-dev
DRIVERS_TABLE=rideshare-drivers-dev
RIDES_TABLE=rideshare-rides-dev

# ---- Auth ----
# Signing secret used by the shared Lambda layer to validate tokens.
JWT_SECRET=replace-me-with-a-long-random-string

# ---- Payments (Stripe test mode only) ----
STRIPE_SECRET_KEY=sk_test_replace_me

# ---- Messaging ----
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:rideshare-notifications
EVENT_BUS_NAME=rideshare-events

# ---- Frontend (React, must be prefixed REACT_APP_) ----
REACT_APP_AWS_REGION=us-east-1
REACT_APP_USER_POOL_ID=us-east-1_replaceMe
REACT_APP_USER_POOL_CLIENT_ID=replace-me
REACT_APP_API_GATEWAY_URL=https://replace-me.execute-api.us-east-1.amazonaws.com
REACT_APP_WEBSOCKET_URL=wss://replace-me.execute-api.us-east-1.amazonaws.com/dev

# ---- CI (set as a GitHub Actions repository secret, not here) ----
# AWS_ROLE_ARN=arn:aws:iam::000000000000:role/github-oidc-deploy
