# Copy to .env and fill in. Never commit .env.

# ---- Backend (Lambda) ----
# Nothing to set here: Terraform sets every Lambda environment variable (table
# names, event bus, Cognito ids, WebSocket endpoint) from its own resources.
# Secrets are Terraform variables. Export them, or put them in a git-ignored
# *.tfvars, before `terraform apply`:
#   TF_VAR_stripe_secret_key=sk_test_...        (Stripe test mode only)
#   TF_VAR_stripe_webhook_secret=whsec_...
#   TF_VAR_from_email=verified-sender@example.com   (must be SES-verified)

# ---- Frontend (React, must be prefixed REACT_APP_) ----
REACT_APP_AWS_REGION=us-east-1
REACT_APP_USER_POOL_ID=us-east-1_replaceMe
REACT_APP_USER_POOL_CLIENT_ID=replace-me
REACT_APP_API_GATEWAY_URL=https://replace-me.execute-api.us-east-1.amazonaws.com
REACT_APP_WEBSOCKET_URL=wss://replace-me.execute-api.us-east-1.amazonaws.com/dev

# ---- CI (set as a GitHub Actions repository secret, not here) ----
# AWS_ROLE_ARN=arn:aws:iam::000000000000:role/github-oidc-deploy
